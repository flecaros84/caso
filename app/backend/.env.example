USE_LLM=false
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference/chat/completions

# Para evitar 429 Too Many Requests en GitHub Models.
LLM_REQUEST_DELAY_SECONDS=12
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_SECONDS=10

DATA_ROOT=../../resources
ANNOUNCEMENTS_DIR=../../resources/img/announcements
CV_DIR=../../resources/pdf/cv
RECOMMENDED_THRESHOLD=75
CONSIDERABLE_THRESHOLD=55
TESSERACT_CMD=

# El modelo por defecto se mantiene aquí. El frontend puede seleccionar otro modelo
# desde app/backend/app/data/github_models.json para cada análisis.
